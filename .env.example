# Settings for home-soc-lab.
#
# `make up` copies this file to .env and fills each empty password with a
# random one. .env is git-ignored. Never commit it.
#
# Passwords take effect only on a fresh lab. To change one: `make down`, edit
# .env, then `make up`.

# Dashboard address: https://localhost:<port>. Bound to 127.0.0.1 only.
DASHBOARD_PORT=8443

# Java heap for the indexer. 1g is the lowest Wazuh supports.
INDEXER_HEAP=1g

# Dashboard login for user "admin". Filebeat also uses it to write alerts.
INDEXER_ADMIN_PASSWORD=

# The dashboard's own service login to the indexer (user "kibanaserver").
DASHBOARD_SERVER_PASSWORD=

# The dashboard's login to the Wazuh API (user "wazuh-wui").
WAZUH_API_PASSWORD=
