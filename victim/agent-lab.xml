
<!-- Added by home-soc-lab. -->
<ossec_config>
  <!-- Ship SSH and other auth events to the manager. -->
  <localfile>
    <log_format>syslog</log_format>
    <location>/var/log/auth.log</location>
  </localfile>

  <!-- Do not restart when the manager sends shared configuration. The agent
       gets that configuration once, about 20 seconds after it first connects,
       and the restart skips any log lines written while it runs. That made
       `make test` fail when it ran straight after `make up`. The lab's shared
       configuration is empty, so the restart gains nothing. -->
  <client>
    <auto_restart>no</auto_restart>
  </client>

  <!-- Real-time file integrity monitoring for the paths that persistence and
       defence-evasion techniques write to. The default agent config watches a
       few system directories on a 12-hour scan; this watches these in real
       time (inotify), so a change raises an alert at once. Week 4's coverage
       run found these paths blind or caught only on the next scan; week 5
       closes that. These directories exist when the agent starts, so the
       real-time watches are set at start, not only after the first scan.
       inotify needs no extra privilege, so it works where auditd does not. -->
  <syscheck>
    <directories realtime="yes" check_all="yes" report_changes="yes">/root</directories>
    <directories realtime="yes" check_all="yes" report_changes="yes">/etc/profile.d</directories>
    <directories realtime="yes" check_all="yes">/etc/cron.d,/etc/systemd/system</directories>
  </syscheck>
</ossec_config>
